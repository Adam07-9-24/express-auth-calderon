<%- include('partials/head') %>
<div class="error-shell">
    <section class="surface error-card">
        <a href="/signIn" class="brand" style="justify-content:center;margin:0 0 40px;color:var(--color-graphite)"><span class="brand-mark" aria-hidden="true">L7</span><span class="brand-copy">Access Lab</span></a>
        <div class="error-code">403</div>
        <h1>Esta sección está restringida</h1>
        <p>Tu cuenta no tiene los permisos necesarios para acceder a esta página. Puedes regresar a tu espacio disponible.</p>
        <a href="/signIn" id="back" class="button button-primary">Volver a mi espacio</a>
    </section>
</div>
<%- include('partials/scripts') %>
<script>
    const current = Auth.payload();
    document.getElementById('back').href = current && !Auth.isExpired(current) ? Auth.homeFor(current.roles) : '/signIn';
</script>
</body>
</html>
