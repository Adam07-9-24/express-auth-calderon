<%- include('partials/head') %>
<div class="auth-layout">
    <section class="auth-story" aria-label="Presentación">
        <a href="/signIn" class="brand">
            <span class="brand-mark" aria-hidden="true">L7</span>
            <span class="brand-copy">Access Lab<small>Seguridad JWT</small></span>
        </a>
        <div class="auth-story-copy">
            <p class="eyebrow">Laboratorio 07 · TECSUP</p>
            <h1>Tu espacio, protegido y simple.</h1>
            <p>Gestiona tu cuenta y accede a la plataforma mediante una experiencia clara, segura y diseñada para concentrarte en lo importante.</p>
        </div>
        <div class="auth-proof" aria-label="Características de seguridad">
            <span>Acceso con JWT</span>
            <span>Contraseñas cifradas</span>
        </div>
    </section>

    <section class="auth-panel">
        <div class="auth-card">
            <div class="auth-heading">
                <p class="eyebrow">Bienvenido de nuevo</p>
                <h2>Inicia sesión</h2>
                <p>Ingresa tus credenciales para continuar a tu espacio de trabajo.</p>
            </div>

            <div id="expired-msg" class="alert alert-warning" hidden role="status">
                Tu sesión expiró. Vuelve a iniciar sesión para continuar.
            </div>
            <div id="form-error" class="alert alert-error" hidden role="alert"></div>

            <form id="signin-form" class="auth-form" novalidate>
                <div class="field">
                    <label for="email">Correo electrónico</label>
                    <input id="email" type="email" required autocomplete="username" inputmode="email" placeholder="nombre@correo.com" aria-describedby="email-help">
                    <p class="field-help" id="email-help">Usa el correo asociado a tu cuenta.</p>
                </div>
                <div class="field">
                    <label for="password">Contraseña</label>
                    <div class="input-wrap">
                        <input id="password" type="password" data-password-input required autocomplete="current-password" placeholder="Ingresa tu contraseña">
                        <button class="password-toggle" type="button" data-password-toggle="password" aria-pressed="false">Mostrar</button>
                    </div>
                </div>
                <button class="button button-primary button-block" type="submit" id="submit">
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span class="button-label">Ingresar a la plataforma</span>
                </button>
            </form>
            <p class="auth-switch">¿Aún no tienes una cuenta? <a href="/signUp">Crear cuenta</a></p>
        </div>
    </section>
</div>
<%- include('partials/scripts') %>
<script>
    const current = Auth.payload();
    if (current && !Auth.isExpired(current)) location.href = Auth.homeFor(current.roles);

    if (new URLSearchParams(location.search).has('expired'))
        document.getElementById('expired-msg').hidden = false;

    document.getElementById('signin-form').addEventListener('submit', async e => {
        e.preventDefault();
        const emailInput = document.getElementById('email');
        const passwordInput = document.getElementById('password');
        const errorBox = document.getElementById('form-error');
        const email = emailInput.value.trim();
        const password = passwordInput.value;
        errorBox.hidden = true;

        emailInput.setAttribute('aria-invalid', String(!email));
        passwordInput.setAttribute('aria-invalid', String(!password));
        if (!email || !password) {
            errorBox.textContent = 'Completa tu correo electrónico y contraseña.';
            errorBox.hidden = false;
            return;
        }

        const btn = document.getElementById('submit');
        UI.setButtonLoading(btn, true, 'Verificando…');
        try {
            const { token } = await Auth.api('/api/auth/signIn', {
                method: 'POST',
                body: JSON.stringify({ email, password })
            });
            Auth.setToken(token);
            location.href = Auth.homeFor(Auth.roles());
        } catch (err) {
            errorBox.textContent = err.message;
            errorBox.hidden = false;
            UI.setButtonLoading(btn, false);
        }
    });
</script>
</body>
</html>
